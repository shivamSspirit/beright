# ============================================
# BERIGHT PROTOCOL - ENVIRONMENT VARIABLES
# ============================================
# Single source of truth for all workspaces
#
# SECURITY:
# - NEVER commit .env to git (already in .gitignore)
# - PRODUCTION secrets go in Railway/Vercel ONLY
# - LOCAL .env should only have DEV/TEST values
# - Run `./scripts/install-hooks.sh` to enable secret scanning
#
# For development: Copy to .env and fill dev values
# For production: Set in Railway/Vercel dashboard
# ============================================

# ============================================
# APP MODE (REQUIRED)
# ============================================
# Controls demo vs production behavior
# - demo: Uses devnet, mock data, paper trading (beright.fun)
# - production: Uses mainnet, live APIs, real trading
BERIGHT_MODE=demo

# Frontend mode indicator
NEXT_PUBLIC_BERIGHT_MODE=demo

# ============================================
# SUPABASE (Database - REQUIRED)
# ============================================
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Frontend public versions
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ============================================
# SOLANA / HELIUS (Blockchain - REQUIRED)
# ============================================
# Get from: https://www.helius.dev/
# Private key as JSON array of 64 bytes
# Generate with: solana-keygen new --outfile keypair.json
SOLANA_PRIVATE_KEY=[0,0,0,...64 bytes]
HELIUS_API_KEY=your-helius-api-key
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
CAPITAL_STRATEGY_PREPARE_ENABLED=false
CAPITAL_STRATEGY_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
CAPITAL_STRATEGY_MAX_USDC_ATOMIC=10000000000
HELIUS_RPC_MAINNET=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_RPC_DEVNET=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_WEBSOCKET_URL=wss://atlas-mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Frontend public RPC
NEXT_PUBLIC_SOLANA_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# ============================================
# PRIVY (Wallet Authentication - REQUIRED)
# ============================================
# Get from: https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret

# ============================================
# ANTHROPIC (Claude AI - REQUIRED)
# ============================================
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ============================================
# MISTRAL (Embeddings - REQUIRED for semantic search)
# ============================================
# Get from: https://console.mistral.ai/
MISTRAL_API_KEY=your-mistral-api-key

# ============================================
# SERPER (Web Search - REQUIRED)
# ============================================
# Get from: https://serper.dev (2,500 free queries, no CC required)
SERPER_API_KEY=your-serper-api-key-here

# ============================================
# UPSTASH REDIS (Rate Limiting - RECOMMENDED)
# ============================================
# Get from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ============================================
# KALSHI (Prediction Markets - OPTIONAL)
# ============================================
# Get from: https://kalshi.com/settings/api
# NOTE: DFlow is now the recommended way to access Kalshi markets
KALSHI_API_KEY=your-kalshi-api-key
KALSHI_API_SECRET=your-kalshi-rsa-private-key
KALSHI_USE_DEMO=true
KALSHI_BUILDER_CODE=BERIGHT_PROTOCOL

# ============================================
# DFLOW (Tokenized Prediction Markets - RECOMMENDED)
# ============================================
# Free API (rate limited without key)
# Get production key from: https://pond.dflow.net/build/api-key
DFLOW_API_KEY=

# Platform fee configuration (BeRight revenue)
# feeAccount: Solana wallet address to receive fees
# platformFeeBps: Fee in basis points (50 = 0.5%, 100 = 1%)
BERIGHT_FEE_WALLET=your-solana-wallet-address
BERIGHT_PLATFORM_FEE_BPS=50

# ============================================
# JITO (MEV Protection - OPTIONAL)
# ============================================
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1
JITO_TIP_FLOOR_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles/tip_floor
JITO_AUTH_KEYPAIR=your-jito-auth-keypair
JITO_DEFAULT_TIP_LAMPORTS=10000
JITO_MAX_TIP_LAMPORTS=100000

# ============================================
# JUPITER DEX (OPTIONAL - defaults work)
# ============================================
JUPITER_API_URL=https://quote-api.jup.ag/v6
JUPITER_REFERRAL_ACCOUNT=
JUPITER_FEE_BPS=50

# ============================================
# ROUTING CONFIG (OPTIONAL - defaults work)
# ============================================
ROUTING_NEW_TOKEN_THRESHOLD_SECONDS=300
ROUTING_HIGH_VOLUME_THRESHOLD_USD=100000
ROUTING_DEFAULT_SLIPPAGE_BPS=300
ROUTING_MAX_SLIPPAGE_BPS=1000

# ============================================
# GROQ (Fast LLM Inference - OPTIONAL)
# ============================================
# Get from: https://console.groq.com/
GROQ_API_KEY=

# ============================================
# GEMINI (Google AI - OPTIONAL)
# ============================================
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=

# ============================================
# OPENAI (GPT - OPTIONAL)
# ============================================
# Get from: https://platform.openai.com/
OPENAI_API_KEY=

# ============================================
# TAVILY (AI Search - OPTIONAL)
# ============================================
# Get from: https://tavily.com/
TAVILY_API_KEY=

# ============================================
# STRIPE (Payments - OPTIONAL)
# ============================================
# Get from: https://dashboard.stripe.com/
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# CRON & WEBHOOKS
# ============================================
# Random secret for cron job authentication
# Generate: openssl rand -hex 32
CRON_SECRET=

# ============================================
# NEXT.JS / APP CONFIG
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
VERCEL_FRONTEND_URL=

# ============================================
# KILL SWITCHES - Emergency Controls
# ============================================
# Set to 'false' to disable features in emergency
# Default: all enabled (true)
TRADING_ENABLED=true
WALLET_WITHDRAWALS=true
API_PUBLIC_ACCESS=true
TELEGRAM_BOT_ENABLED=true
# Capital vaults are hard-wired to Solana devnet until the program is audited.
CAPITAL_DEVNET_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_CAPITAL_DEVNET_RPC_URL=https://api.devnet.solana.com
