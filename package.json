{
  "name": "beright",
  "version": "1.0.1",
  "private": true,
  "workspaces": [
    "beright-ts",
    "berightweb",
    "forecaster-scoring-engine"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev:api": "npm run dev --workspace=beright-ts",
    "dev:web": "npm run dev --workspace=berightweb",
    "heartbeat": "npm run heartbeat --workspace=beright-ts",
    "test:calibration": "cd calibration-program && npm run test:calibration"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  },
  "dependencies": {
    "@solana-program/memo": "^0.11.0",
    "@solana/kit": "^6.0.0",
    "@supabase/server": "^1.4.1"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.2.0",
  "overrides": {
    "@solana/kit": "^6.0.0"
  }
}
