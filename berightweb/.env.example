# BeRight Web - Environment Variables
# ====================================
# Frontend configuration for Vercel deployment

# ============================================
# API URL (REQUIRED)
# ============================================
# Points to beright-ts backend on Railway
NEXT_PUBLIC_API_URL=https://your-railway-app.railway.app

# ============================================
# PRIVY AUTH (REQUIRED for wallet connection)
# ============================================
# Get from: https://privy.io/dashboard
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# ============================================
# SOLANA CONFIG
# ============================================
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# ============================================
# SUPABASE (for client-side queries)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================
# FEATURE FLAGS
# ============================================
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_ENABLE_TRADING=false

# ============================================
# ANALYTICS (OPTIONAL)
# ============================================
# NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
