{
  "name": "beright-vault",
  "version": "0.1.0",
  "description": "BeRight Protocol — Solana Vault Program (Anchor 0.32.1)",
  "license": "MIT",
  "scripts": {
    "build":       "anchor build",
    "test":        "anchor test",
    "test:local":  "anchor test --skip-local-validator",
    "deploy:dev":  "anchor deploy --provider.cluster devnet",
    "deploy:main": "anchor deploy --provider.cluster mainnet-beta",
    "verify":      "anchor verify $(anchor keys list | awk '{print $2}')",
    "lint":        "eslint tests/ app/ --ext .ts"
  },
  "dependencies": {
    "@coral-xyz/anchor":      "^0.32.1",
    "@solana/spl-token":      "^0.4.9",
    "@solana/web3.js":        "^1.98.0"
  },
  "devDependencies": {
    "@types/chai":            "^4.3.12",
    "@types/mocha":           "^10.0.6",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser":        "^7.0.0",
    "chai":                   "^4.4.1",
    "eslint":                 "^8.57.0",
    "mocha":                  "^10.3.0",
    "ts-mocha":               "^10.0.0",
    "typescript":             "^5.4.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
