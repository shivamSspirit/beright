# Forecaster Scoring Engine - Environment Variables

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/forecaster_scoring

# Redis (for BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PRIVATE_KEY=  # Base58 encoded private key for score updates
CALIBRATION_PROGRAM_ID=GDMJpNckYfRCKbsC1m1qRx1x4jbtKGhdAHRLbQqrihPZ

# Platform API Keys
# Polymarket (Goldsky GraphQL)
POLYMARKET_GOLDSKY_URL=https://api.goldsky.com/api/public/project_xxx/subgraphs/polymarket/1.0.0/gn
POLYMARKET_API_KEY=  # Optional

# Metaculus
METACULUS_API_URL=https://www.metaculus.com/api2
METACULUS_API_KEY=  # Optional (for higher rate limits)

# Kalshi
KALSHI_API_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_API_KEY=
KALSHI_API_SECRET=

# Manifold
MANIFOLD_API_URL=https://api.manifold.markets/v0
MANIFOLD_API_KEY=  # Optional

# Logging
LOG_LEVEL=info  # debug | info | warn | error

# Cron Schedules (crontab format)
CRON_INGEST_POLYMARKET=0 */1 * * *  # Every hour
CRON_INGEST_METACULUS=0 2 * * *  # Daily at 2 AM
CRON_INGEST_KALSHI=0 3 * * *  # Daily at 3 AM
CRON_INGEST_MANIFOLD=0 4 * * *  # Daily at 4 AM
CRON_CALCULATE_SCORES=0 5 * * *  # Daily at 5 AM
CRON_UPDATE_ONCHAIN=0 6 * * 0  # Weekly on Sunday at 6 AM

# API Server
API_PORT=3000
API_HOST=0.0.0.0

# Phase 4: Normalization Constants (to be filled after empirical validation)
NORM_S1_MEAN=500
NORM_S1_STD=150
NORM_S2_MEAN=500
NORM_S2_STD=150
NORM_S3_MEAN=500
NORM_S3_STD=150
NORM_S4_MEAN=500
NORM_S4_STD=150
NORM_S5_MEAN=500
NORM_S5_STD=150
NORM_S6_MEAN=500
NORM_S6_STD=150
