{
  "name": "beright-calibration-program",
  "version": "0.1.0",
  "description": "BeRight Forecaster Calibration Tracking - Solana Program",
  "license": "MIT",
  "scripts": {
    "build": "anchor build",
    "build:verifiable": "anchor build --verifiable",
    "test": "anchor test",
    "test:unit": "anchor test --skip-deploy",
    "test:calibration": "ts-node test-helius-simple.ts",
    "test:forecaster": "ts-node test-helius-simple.ts --forecaster",
    "deploy:devnet": "anchor deploy --provider.cluster devnet",
    "deploy:mainnet": "anchor deploy --provider.cluster mainnet",
    "idl:init": "anchor idl init --filepath target/idl/calibration.json",
    "idl:upgrade": "anchor idl upgrade --filepath target/idl/calibration.json",
    "clean": "anchor clean",
    "localnet": "solana-test-validator"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/web3.js": "^1.95.0",
    "bs58": "^5.0.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "dotenv": "^16.6.1",
    "mocha": "^9.0.3",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
